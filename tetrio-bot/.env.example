BOT_USERNAME=
BOT_PASSWORD=
# Optional absolute path if the adapter binary is stored elsewhere:
# BOT_ADAPTER_PATH=/absolute/path/to/triangle-adapter

# Shared service capacity (1-32 rooms, default 20):
# BOT_MAX_WORKERS=20
# Replays are kept without automatic expiration, count or size limits.
# Detailed per-move adapter logging is disabled by default.
# BOT_LOG_MOVES=1
