BOT_USERNAME=
BOT_PASSWORD=
# Optional absolute path if the adapter binary is stored elsewhere:
# BOT_ADAPTER_PATH=/absolute/path/to/triangle-adapter

# Shared service capacity (1-32 rooms, default 20):
# BOT_MAX_WORKERS=20
# BOT_IDLE_MINUTES=15
# Replays: oldest managed files are removed when any limit is exceeded.
# BOT_REPLAY_DAYS=14
# BOT_REPLAY_MAX_FILES=1000
# BOT_REPLAY_MAX_MB=2048
# BOT_REPLAY_FILE_MB=32
# Detailed per-move adapter logging is disabled by default.
# BOT_LOG_MOVES=1
